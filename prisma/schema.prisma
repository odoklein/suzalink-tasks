// Suzali Tasks — gestion de projets et de tâches de l'agence.
// Modélisé sur le fonctionnement réel des projets clients : retours qui
// arrivent par vagues, tâches bloquées côté client, mises en ligne datées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ClientKind {
  AGENCY // agence partenaire qui nous sous-traite (ex. 33 Degrés)
  DIRECT // client final en direct
}

enum ProjectStatus {
  ACTIVE
  WAITING_CLIENT
  PAUSED
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  DONE
}

/// Type d'événement du journal d'activité : le texte français est généré à
/// l'écriture (src/lib/activity-copy.ts), le type et les valeurs restent
/// exploitables (rapports, délais « chez le client », litiges).
enum ActivityType {
  NOTE
  TASK_CREATED
  STATUS_CHANGED
  ASSIGNED
  BILLABLE_CHANGED
  DUE_CHANGED
  PRIORITY_CHANGED
  TITLE_CHANGED
  COMMENTED
  TASK_DELETED
  TASK_RESTORED
  IMPORTED
  DELIVERED
  CLIENT_MESSAGE
  PROJECT_UPDATED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String // hash du code PIN à 6 chiffres
  color        String   @default("#3B6CF6")
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  // Protection contre les essais en série : 5 erreurs → blocage de 15 min, puis 1 h, puis 24 h
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lockLevel    Int       @default(0) // nombre de blocages consécutifs (remis à 0 à la connexion réussie)

  // Révocation des sessions : le JWT porte la version ; l'incrémenter déconnecte tous les appareils.
  sessionVersion Int     @default(0)
  active         Boolean @default(true) // compte désactivé : plus de connexion, sessions refusées
  mustChangePin  Boolean @default(false) // code donné par un admin : à remplacer à la première connexion

  assignedTasks  Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreator")
  ledProjects    Project[]       @relation("ProjectLead")
  comments       Comment[]
  deliveries     Delivery[]
  activities     Activity[]
  clientMessages ClientMessage[]

  // Intégrations (Phases 6-8) : relations regroupées ici pour faciliter la fusion.
  loginEvents      LoginEvent[]
  oauthAccounts    OAuthAccount[]
  approvedCaptures Meeting[]      @relation("MeetingCaptureApprover")
}

model Client {
  id        String     @id @default(cuid())
  name      String
  kind      ClientKind @default(DIRECT)
  contacts  String? // ancien champ libre, conservé : « Luna Cervi (cheffe de projet), Clémentine Burdet-Micolle »
  notes     String?
  createdAt DateTime   @default(now())

  projects       Project[]
  contactRecords Contact[]
  emails         EmailMessage[]
}

/// Interlocuteur d'un client ou d'une agence (remplace le champ libre Client.contacts).
model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String? // « cheffe de projet »
  email     String?  @unique
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  messages ClientMessage[]
  rounds   FeedbackRound[]
}

enum RoundStatus {
  OPEN
  DELIVERED
  CLOSED
}

/// Lot de retours client (un tableau collé, un e-mail…) : la preuve de ce qui a été demandé et quand.
model FeedbackRound {
  id         String      @id @default(cuid())
  label      String
  receivedAt DateTime    @default(now())
  channel    Channel     @default(SHEETS)
  sheetUrl   String?
  rawText    String? // collage d'origine, conservé tel quel
  status     RoundStatus @default(OPEN)
  createdAt  DateTime    @default(now())

  projectId     String
  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromContactId String?
  fromContact   Contact?      @relation(fields: [fromContactId], references: [id], onDelete: SetNull)
  closedById    String?
  closedBy      Delivery?     @relation(fields: [closedById], references: [id], onDelete: SetNull)
  tasks         Task[]
  meeting       Meeting? // lot créé depuis le compte rendu d'une réunion (channel CALL)
  email         EmailMessage? // lot créé depuis un e-mail client (channel EMAIL)

  @@index([projectId, receivedAt])
}

enum MessageKind {
  RECAP
  FOLLOW_UP
  QUOTE
}

/// D'où vient une action ou un message : l'interface, un e-mail, un outil connecté…
enum Channel {
  WEB
  EMAIL
  WHATSAPP
  CALL
  PORTAL
  API
  MCP
  DEPLOY
  SHEETS
  WIDGET
  CHAT
  SYSTEM
}

/// Message envoyé au client (récap, relance, devis) : la preuve de ce qui lui a été dit et quand.
model ClientMessage {
  id     String      @id @default(cuid())
  kind   MessageKind
  body   String
  sentAt DateTime    @default(now())
  via    Channel     @default(EMAIL)
  since  DateTime? // récap : tâches faites depuis ; relance : début de l'attente la plus ancienne

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toId      String?
  to        Contact? @relation(fields: [toId], references: [id], onDelete: SetNull)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tasks     Task[]   @relation("MessageTasks")

  @@index([projectId, sentAt])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  key          String        @unique // préfixe des tâches : BG-12
  color        String        @default("#3B6CF6")
  status       ProjectStatus @default(ACTIVE)
  endClient    String? // client final quand le projet passe par une agence
  siteUrl      String?
  description  String?
  statusNote   String? // « point d'étape » : où on en est, et la prochaine action
  statusNoteAt DateTime?
  dueDate      DateTime?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId   String?
  lead     User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  taskCounter Int        @default(0)
  tasks       Task[]
  deliveries  Delivery[]
  activities  Activity[]

  lastChasedAt   DateTime? // dernière relance du client sur ce projet
  clientMessages ClientMessage[]
  rounds         FeedbackRound[]

  // P4-09 : type, modèle de départ, pages et jalons
  type       ProjectType @default(OTHER)
  startDate  DateTime?
  zones      Zone[]
  milestones Milestone[]
  extras     Extra[]

  meetings Meeting[]
  emails   EmailMessage[]
}

enum ExtraStatus {
  DRAFT
  QUOTED
  APPROVED
  REJECTED
  INVOICED
  PAID
}

/// Avenant : modifications hors périmètre chiffrées, devisées puis facturées.
/// La facture elle-même est émise ailleurs : `invoiceRef` n'est qu'une référence (jamais de numérotation ici).
model Extra {
  id          String      @id @default(cuid())
  number      Int
  title       String
  amountCents Int?
  status      ExtraStatus @default(DRAFT)
  quotedAt    DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  invoicedAt  DateTime?
  invoiceRef  String?
  paidAt      DateTime?
  createdAt   DateTime    @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, number])
  @@index([status])
}

enum ProjectType {
  VITRINE
  ECOMMERCE
  REFONTE
  MAINTENANCE
  SOCIAL
  OTHER
}

/// Page ou section d'un projet (« Homepage », « Fiche produit ») : référentiel des zones des tâches.
model Zone {
  id        String  @id @default(cuid())
  name      String
  url       String?
  position  Float   @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
}

/// Jalon de projet (« Maquettes validées », « Mise en ligne »).
model Milestone {
  id          String    @id @default(cuid())
  name        String
  dueDate     DateTime?
  completedAt DateTime?
  position    Float     @default(0)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, position])
}

/// Modèle de projet : jalons, pages et tâches de départ (échéances relatives au démarrage).
model ProjectTemplate {
  id         String         @id @default(cuid())
  name       String         @unique
  type       ProjectType    @default(OTHER)
  milestones String[]
  zones      String[]
  tasks      TemplateTask[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model TemplateTask {
  id          String          @id @default(cuid())
  title       String
  zone        String?
  milestone   String?
  estimateMin Int?
  offsetDays  Int? // échéance = démarrage + N jours
  position    Float           @default(0)
  templateId  String
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Task {
  id              String     @id @default(cuid())
  number          Int // numéro dans le projet (BG-12)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(NONE)
  zone            String? // page ou section concernée : « Homepage », « Fiche produit »
  source          String? // origine : « Retours Luna 06/10 »
  billable        Boolean    @default(false) // modification hors périmètre, à facturer
  dueDate         DateTime?
  position        Float      @default(0)
  completedAt     DateTime?
  statusChangedAt DateTime   @default(now()) // depuis quand la tâche est dans son statut (ex. « chez le client depuis 4 j »)
  waitingSince    DateTime? // posé à l'entrée dans « Chez le client », effacé à la sortie
  externalKey     String? // clé de déduplication d'un retour importé : sha1(page|retour) normalisés (src/lib/import-key.ts)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    User?   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  comments   Comment[]
  activities Activity[]

  // Relancer le client (P4-05)
  waitingFor   String? // « visuels HD », « textes page À propos »
  followUpAt   DateTime? // date de relance choisie à la main
  lastChasedAt DateTime?
  messages     ClientMessage[] @relation("MessageTasks")

  deliveries DeliveryTask[]

  // P4-09 : référentiels (Task.zone reste le libellé pendant la transition)
  zoneId      String?
  zoneRef     Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  // P4-10 : hors périmètre chiffré, regroupé en avenants
  billingNote          String?
  estimatedAmountCents Int?
  extraId              String?
  extra                Extra?  @relation(fields: [extraId], references: [id], onDelete: SetNull)

  roundId String? // lot de retours d'origine (P4-06)
  round   FeedbackRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  meetingProposals MeetingProposal[] // action de réunion qui a créé la tâche, ou qui y a été rattachée
  emailProposals   EmailProposal[] // action d'un e-mail client qui a créé la tâche, ou qui y a été rattachée

  @@unique([projectId, number])
  @@unique([projectId, externalKey]) // plusieurs NULL autorisés
  @@index([projectId, status, position])
  @@index([assigneeId, status])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// Mise en ligne datée — la preuve de ce qui a été livré et quand.
model Delivery {
  id         String   @id @default(cuid())
  title      String
  notes      String?
  url        String?
  deployedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  closedRounds FeedbackRound[]

  // P4-07 : contenu et origine de la mise en ligne
  tasks       DeliveryTask[]
  source      Channel        @default(WEB)
  externalId  String?        @unique // identifiant chez l'hébergeur (déploiement Netlify, Vercel…)
  commitSha   String?
  context     String? // production, preview…
  confirmedAt DateTime?
  deletedAt   DateTime? // suppression annulable

  @@index([projectId, deployedAt])
}

/// Tâches livrées par une mise en ligne.
model DeliveryTask {
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([deliveryId, taskId])
  @@index([taskId])
}

/// Outbox d'événements : écrite dans la même transaction que le changement,
/// lue par le job `dispatch_events` (notifications, webhooks, temps réel, sync).
/// L'Activity reste le fil lisible de l'interface.
model Event {
  id           String    @id @default(cuid())
  type         String // task.created, task.status_changed, comment.created…
  payload      Json
  via          Channel   @default(WEB)
  projectId    String?
  taskId       String?
  actorId      String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, createdAt])
  @@index([projectId, createdAt])
}

/// File de travaux, consommée par /api/cron/tick (appelé chaque minute).
model Job {
  id        String    @id @default(cuid())
  kind      String // dispatch_events, daily, digest, intake…
  payload   Json      @default("{}")
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lockedAt  DateTime?
  doneAt    DateTime?
  lastError String?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}

/// Dernier signal reçu par fournisseur (webhooks, cron) : panneau Intégrations.
model IntegrationStatus {
  provider       String    @id // cron, netlify, github, vercel, postmark, telegram…
  lastReceivedAt DateTime?
  lastOkAt       DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Journal des connexions (réussies ou non) : Paramètres › Journal.
model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  method    String   @default("PIN") // PIN, GOOGLE
  ip        String?
  ua        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Limitation de débit à fenêtre fixe (clé = politique + IP ou clé d'API).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  type       ActivityType @default(NOTE)
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  data       Json? // { from, to } : attribution, échéance, hors périmètre, priorité, titre

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  // SetNull : l'historique du projet garde la trace d'une tâche supprimée.
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([type, createdAt])
}

// ─── Réunions (docs/REUNIONS-PLAN.md) ────────────────────────────────────────
// Agenda Google → réunion associée à un projet → enregistrement validé par un
// humain → transcription → actions proposées par l'IA, validées une par une.

/// Compte Google relié par un membre (P7-08) : jetons chiffrés, état de la synchronisation d'agenda.
model OAuthAccount {
  id                String    @id @default(cuid())
  provider          String // google
  providerAccountId String // « sub » du jeton d'identité
  email             String
  scopes            String[]
  refreshTokenEnc   String // AES-256-GCM (src/lib/secret-box.ts, clé TOKEN_ENC_KEY)
  accessTokenEnc    String?
  expiresAt         DateTime?
  calendarSyncedAt  DateTime?
  lastError         String?
  lastErrorAt       DateTime?
  reconnectRequired Boolean   @default(false) // accès retiré chez Google : la synchronisation s'arrête
  gmailConnectedAt  DateTime? // accès Gmail (lecture seule) accordé : seuls les e-mails reçus ensuite sont analysés
  gmailHistoryId    String? // curseur de l'historique Gmail
  gmailPendingIds   String[] // messages à lire aux prochains passages (lots bornés)
  gmailSyncedAt     DateTime?
  gmailError        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  userId   String
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings Meeting[]
  emails   EmailMessage[]

  @@unique([provider, providerAccountId])
  @@unique([userId, provider]) // un compte Google par membre
}

/// Appel à un modèle d'IA : volumes et durée, jamais le contenu envoyé.
model AiRun {
  id           String   @id @default(cuid())
  kind         String // meeting_transcription, meeting_report…
  provider     String   @default("mistral")
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  audioSeconds Int?
  costMicros   Int?
  durationMs   Int?
  ok           Boolean  @default(true)
  error        String?
  projectId    String?
  meetingId    String?
  userId       String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

enum MeetingPlatform {
  GOOGLE_MEET
  TEAMS
  ZOOM
}

/// Capture par le robot : rien ne part sans validation humaine.
enum CaptureStatus {
  OFF // pas d'enregistrement (défaut)
  APPROVED // validé ; envoi du robot programmé avant le début
  JOINING // robot envoyé
  WAITING_ADMISSION // dans la salle d'attente
  RECORDING
  ENDED
  FAILED
  CANCELLED // réunion annulée ou validation retirée
}

enum ReportStatus {
  NONE
  TRANSCRIBING
  EXTRACTING
  READY // actions à revoir
  REVIEWED // toutes traitées
  FAILED
}

/// Réunion trouvée dans un agenda (Gmail viendra plus tard).
model Meeting {
  id              String           @id @default(cuid())
  title           String
  startsAt        DateTime
  endsAt          DateTime
  cancelledAt     DateTime?
  platform        MeetingPlatform?
  joinUrl         String? // lien normalisé (sans paramètres de suivi)
  nativeMeetingId String? // abc-defg-hij (Meet), identifiant Teams/Zoom attendu par le robot
  passcode        String? // Teams grand public, Zoom : code extrait du lien
  attendees       Json             @default("[]") // [{ email, name?, organizer?, self?, responseStatus? }]
  internalOnly    Boolean          @default(false) // aucun invité hors de l'agence : jamais proposée à l'enregistrement
  source          String           @default("calendar") // calendar, email (réunion trouvée dans un e-mail)
  emailMessageId  String? // e-mail d'où vient la réunion proposée
  confirmedAt     DateTime? // réunion trouvée dans un e-mail : confirmée par un membre avant tout enregistrement

  // Origine : un événement de l'agenda principal d'un membre
  oauthAccountId  String?
  oauthAccount    OAuthAccount? @relation(fields: [oauthAccountId], references: [id], onDelete: SetNull)
  calendarEventId String? // identifiant de l'occurrence (singleEvents=true)
  iCalUid         String?

  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectSuggestedBy String? // contact, titre, manuel
  projectConfirmedAt DateTime?

  captureStatus       CaptureStatus @default(OFF)
  captureApprovedById String?
  captureApprovedBy   User?         @relation("MeetingCaptureApprover", fields: [captureApprovedById], references: [id], onDelete: SetNull)
  captureApprovedAt   DateTime?
  captureExternalId   String? // identifiant de la réunion chez Vexa
  captureError        String? // message français affiché dans Réunions
  joinedAt            DateTime?
  leftAt              DateTime?
  recordingKey        String? // enregistrement audio, sur le serveur de capture
  recordingPurgedAt   DateTime?

  reportStatus     ReportStatus @default(NONE)
  reportError      String?
  transcriptSource String? // vexa, mistral
  summary          String?
  decisions        String[]
  openQuestions    String[]
  reportReadyAt    DateTime?
  segmentsPurgedAt DateTime?
  deletedAt        DateTime? // supprimée par un membre : contenu effacé, identité gardée pour que l'agenda ne la recrée pas

  roundId   String?           @unique // lot « Réunion du 12/10 » (channel CALL), créé à la première validation
  round     FeedbackRound?    @relation(fields: [roundId], references: [id], onDelete: SetNull)
  segments  MeetingSegment[]
  proposals MeetingProposal[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([oauthAccountId, calendarEventId])
  @@index([startsAt])
  @@index([captureStatus, startsAt])
  @@index([reportStatus, startsAt])
  @@index([projectId, startsAt])
}

/// Passage de transcription : la preuve citée par une action proposée.
model MeetingSegment {
  id      String  @id @default(cuid())
  index   Int
  speaker String? // nom affiché dans la réunion ; vide quand l'attribution est incertaine
  startMs Int
  endMs   Int
  text    String

  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, index])
}

enum ProposalBasis {
  REQUESTED // le client l'a demandé
  COMMITTED // quelqu'un s'y est engagé
  INFERRED // déduit, à confirmer
}

enum ProposalStatus {
  PENDING
  ACCEPTED // tâche créée
  LINKED // rattachée à une tâche existante
  REJECTED
}

/// Action proposée par l'IA, validée une par une : la tâche garde sa preuve.
model MeetingProposal {
  id              String         @id @default(cuid())
  position        Int            @default(0)
  title           String
  description     String?
  basis           ProposalBasis
  quote           String // citation exacte, vérifiée dans la transcription
  segmentIndexes  Int[]
  ownerText       String? // « Hichem », « l'équipe Suzali », tel que dit
  suggestedUserId String? // membre reconnu sans ambiguïté
  dueText         String? // « mardi prochain », tel que dit
  suggestedDue    DateTime? // minuit à Paris ; null si la date dite est ambiguë
  zone            String?
  duplicateOfId   String? // tâche ouverte probablement identique
  status          ProposalStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?

  taskId    String? // tâche créée (ACCEPTED) ou rattachée (LINKED)
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  meetingId String
  meeting   Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
}

// ─── E-mails clients (Gmail, lecture seule) ──────────────────────────────────
// Chaque e-mail échangé avec un client est rattaché au client, puis au projet ;
// l'IA propose des actions (citations vérifiées) et des réunions, validées par
// un membre. Le texte n'est gardé que 30 jours ; les inconnus, en compteurs.

enum EmailDirection {
  IN // reçu
  OUT // envoyé par un membre
}

enum EmailAnalysis {
  NONE // pas analysé (avant la connexion de Gmail, envoyé, sans texte…)
  PENDING
  READY // actions à revoir
  REVIEWED // toutes traitées, ou rien à faire
  FAILED
}

/// E-mail échangé avec un client, lu dans Gmail.
model EmailMessage {
  id             String         @id @default(cuid())
  gmailMessageId String
  gmailThreadId  String
  rfcMessageId   String?        @unique // en-tête Message-ID : un e-mail reçu par deux membres n'est gardé qu'une fois
  direction      EmailDirection
  fromEmail      String
  fromName       String?
  toEmails       String[] // destinataires (À et Cc)
  subject        String
  snippet        String?
  sentAt         DateTime
  bodyText       String? // texte sans l'historique cité ; effacé après 30 jours
  bodyPurgedAt   DateTime?
  meetingLink    String? // lien Meet, Teams ou Zoom trouvé dans le message
  routedBy       String? // contact, domaine, titre, fil, manuel
  analysis       EmailAnalysis  @default(NONE)
  analysisError  String?
  summary        String?
  createdAt      DateTime       @default(now())

  oauthAccountId String?
  oauthAccount   OAuthAccount?   @relation(fields: [oauthAccountId], references: [id], onDelete: SetNull)
  clientId       String?
  client         Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  roundId        String?         @unique // lot « E-mail du 12/10 » (channel EMAIL), créé à la première validation
  round          FeedbackRound?  @relation(fields: [roundId], references: [id], onDelete: SetNull)
  proposals      EmailProposal[]

  @@unique([oauthAccountId, gmailMessageId])
  @@index([clientId, sentAt])
  @@index([projectId, sentAt])
  @@index([gmailThreadId])
  @@index([analysis, sentAt])
}

/// Action proposée par l'IA à partir d'un e-mail client, validée une par une.
model EmailProposal {
  id              String         @id @default(cuid())
  position        Int            @default(0)
  title           String
  description     String?
  basis           ProposalBasis
  quote           String // citation exacte, vérifiée dans l'e-mail
  ownerText       String?
  suggestedUserId String?
  dueText         String?
  suggestedDue    DateTime?
  zone            String?
  duplicateOfId   String?
  status          ProposalStatus @default(PENDING)
  reviewedById    String?
  reviewedAt      DateTime?

  taskId  String?
  task    Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  emailId String
  email   EmailMessage @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId, status])
}

/// Interlocuteur inconnu (ni membre, ni contact) : des compteurs, jamais le contenu.
/// Proposé comme nouveau contact quand l'agence a vraiment échangé avec lui.
model EmailSender {
  email       String    @id
  name        String?
  domain      String
  received    Int       @default(0) // messages reçus de lui
  sent        Int       @default(0) // messages que l'agence lui a envoyés
  firstSeenAt DateTime
  lastSeenAt  DateTime
  dismissedAt DateTime?

  @@index([dismissedAt, lastSeenAt])
}
