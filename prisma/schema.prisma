// Suzali Tasks — gestion de projets et de tâches de l'agence.
// Modélisé sur le fonctionnement réel des projets clients : retours qui
// arrivent par vagues, tâches bloquées côté client, mises en ligne datées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ClientKind {
  AGENCY // agence partenaire qui nous sous-traite (ex. 33 Degrés)
  DIRECT // client final en direct
}

enum ProjectStatus {
  ACTIVE
  WAITING_CLIENT
  PAUSED
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  DONE
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Canal par lequel une action est arrivée (Actor.via, Event.via).
/// Même définition que P4-05 : à dédupliquer à la fusion.
enum Channel {
  WEB
  EMAIL
  WHATSAPP
  CALL
  PORTAL
  API
  MCP
  DEPLOY
  SHEETS
  WIDGET
  CHAT
  SYSTEM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String // hash du code PIN à 6 chiffres
  color        String   @default("#3B6CF6")
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  // Protection contre les essais en série : 5 erreurs → 15 min de blocage
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  assignedTasks Task[]     @relation("TaskAssignee")
  createdTasks  Task[]     @relation("TaskCreator")
  ledProjects   Project[]  @relation("ProjectLead")
  comments      Comment[]
  deliveries    Delivery[]
  activities    Activity[]

  // Intégrations (Phases 6-8) : relations regroupées ici pour faciliter la fusion.
  loginEvents LoginEvent[]
}

model Client {
  id        String     @id @default(cuid())
  name      String
  kind      ClientKind @default(DIRECT)
  contacts  String? // « Luna Cervi (cheffe de projet), Clémentine Burdet-Micolle »
  notes     String?
  createdAt DateTime   @default(now())

  projects Project[]
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  key          String        @unique // préfixe des tâches : BG-12
  color        String        @default("#3B6CF6")
  status       ProjectStatus @default(ACTIVE)
  endClient    String? // client final quand le projet passe par une agence
  siteUrl      String?
  description  String?
  statusNote   String? // « point d'étape » : où on en est, et la prochaine action
  statusNoteAt DateTime?
  dueDate      DateTime?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId   String?
  lead     User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  taskCounter Int        @default(0)
  tasks       Task[]
  deliveries  Delivery[]
  activities  Activity[]
}

model Task {
  id              String     @id @default(cuid())
  number          Int // numéro dans le projet (BG-12)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(NONE)
  zone            String? // page ou section concernée : « Homepage », « Fiche produit »
  source          String? // origine : « Retours Luna 06/10 »
  billable        Boolean    @default(false) // modification hors périmètre, à facturer
  dueDate         DateTime?
  position        Float      @default(0)
  completedAt     DateTime?
  statusChangedAt DateTime   @default(now()) // depuis quand la tâche est dans son statut (ex. « chez le client depuis 4 j »)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    User?   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  comments   Comment[]
  activities Activity[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
  @@index([assigneeId, status])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// Mise en ligne datée — la preuve de ce qui a été livré et quand.
model Delivery {
  id         String   @id @default(cuid())
  title      String
  notes      String?
  url        String?
  deployedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// Outbox d'événements : écrite dans la même transaction que le changement,
/// lue par le job `dispatch_events` (notifications, webhooks, temps réel, sync).
/// L'Activity reste le fil lisible de l'interface.
model Event {
  id           String    @id @default(cuid())
  type         String // task.created, task.status_changed, comment.created…
  payload      Json
  via          Channel   @default(WEB)
  projectId    String?
  taskId       String?
  actorId      String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, createdAt])
  @@index([projectId, createdAt])
}

/// File de travaux, consommée par /api/cron/tick (appelé chaque minute).
model Job {
  id        String    @id @default(cuid())
  kind      String // dispatch_events, daily, digest, intake…
  payload   Json      @default("{}")
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lockedAt  DateTime?
  doneAt    DateTime?
  lastError String?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}

/// Dernier signal reçu par fournisseur (webhooks, cron) : panneau Intégrations.
model IntegrationStatus {
  provider       String    @id // cron, netlify, github, vercel, postmark, telegram…
  lastReceivedAt DateTime?
  lastOkAt       DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Journal des connexions (réussies ou non) : Paramètres › Journal.
model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  method    String   @default("PIN") // PIN, GOOGLE
  ip        String?
  ua        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Limitation de débit à fenêtre fixe (clé = politique + IP ou clé d'API).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}
