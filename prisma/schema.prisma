// Suzali Tasks — gestion de projets et de tâches de l'agence.
// Modélisé sur le fonctionnement réel des projets clients : retours qui
// arrivent par vagues, tâches bloquées côté client, mises en ligne datées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ClientKind {
  AGENCY // agence partenaire qui nous sous-traite (ex. 33 Degrés)
  DIRECT // client final en direct
}

enum ProjectStatus {
  ACTIVE
  WAITING_CLIENT
  PAUSED
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  DONE
}

/// Type d'événement du journal d'activité : le texte français est généré à
/// l'écriture (src/lib/activity-copy.ts), le type et les valeurs restent
/// exploitables (rapports, délais « chez le client », litiges).
enum ActivityType {
  NOTE
  TASK_CREATED
  STATUS_CHANGED
  ASSIGNED
  BILLABLE_CHANGED
  DUE_CHANGED
  PRIORITY_CHANGED
  TITLE_CHANGED
  COMMENTED
  TASK_DELETED
  TASK_RESTORED
  IMPORTED
  DELIVERED
  CLIENT_MESSAGE
  PROJECT_UPDATED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}


model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String // hash du code PIN à 6 chiffres
  color        String   @default("#3B6CF6")
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  // Protection contre les essais en série : 5 erreurs → blocage de 15 min, puis 1 h, puis 24 h
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lockLevel    Int       @default(0) // nombre de blocages consécutifs (remis à 0 à la connexion réussie)

  // Révocation des sessions : le JWT porte la version ; l'incrémenter déconnecte tous les appareils.
  sessionVersion Int     @default(0)
  active         Boolean @default(true) // compte désactivé : plus de connexion, sessions refusées
  mustChangePin  Boolean @default(false) // code donné par un admin : à remplacer à la première connexion

  assignedTasks  Task[]          @relation("TaskAssignee")
  createdTasks   Task[]          @relation("TaskCreator")
  ledProjects    Project[]       @relation("ProjectLead")
  comments       Comment[]
  deliveries     Delivery[]
  activities     Activity[]
  clientMessages ClientMessage[]

  // Intégrations (Phases 6-8) : relations regroupées ici pour faciliter la fusion.
  loginEvents    LoginEvent[]
}

model Client {
  id        String     @id @default(cuid())
  name      String
  kind      ClientKind @default(DIRECT)
  contacts  String? // ancien champ libre, conservé : « Luna Cervi (cheffe de projet), Clémentine Burdet-Micolle »
  notes     String?
  createdAt DateTime   @default(now())

  projects       Project[]
  contactRecords Contact[]
}

/// Interlocuteur d'un client ou d'une agence (remplace le champ libre Client.contacts).
model Contact {
  id        String   @id @default(cuid())
  name      String
  role      String? // « cheffe de projet »
  email     String?  @unique
  phone     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  messages ClientMessage[]
  rounds   FeedbackRound[]
}

enum RoundStatus {
  OPEN
  DELIVERED
  CLOSED
}

/// Lot de retours client (un tableau collé, un e-mail…) : la preuve de ce qui a été demandé et quand.
model FeedbackRound {
  id         String      @id @default(cuid())
  label      String
  receivedAt DateTime    @default(now())
  channel    Channel     @default(SHEETS)
  sheetUrl   String?
  rawText    String? // collage d'origine, conservé tel quel
  status     RoundStatus @default(OPEN)
  createdAt  DateTime    @default(now())

  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromContactId String?
  fromContact   Contact?  @relation(fields: [fromContactId], references: [id], onDelete: SetNull)
  closedById    String?
  closedBy      Delivery? @relation(fields: [closedById], references: [id], onDelete: SetNull)
  tasks         Task[]

  @@index([projectId, receivedAt])
}

enum MessageKind {
  RECAP
  FOLLOW_UP
  QUOTE
}

/// D'où vient une action ou un message : l'interface, un e-mail, un outil connecté…
enum Channel {
  WEB
  EMAIL
  WHATSAPP
  CALL
  PORTAL
  API
  MCP
  DEPLOY
  SHEETS
  WIDGET
  CHAT
  SYSTEM
}

/// Message envoyé au client (récap, relance, devis) : la preuve de ce qui lui a été dit et quand.
model ClientMessage {
  id     String      @id @default(cuid())
  kind   MessageKind
  body   String
  sentAt DateTime    @default(now())
  via    Channel     @default(EMAIL)
  since  DateTime? // récap : tâches faites depuis ; relance : début de l'attente la plus ancienne

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toId      String?
  to        Contact? @relation(fields: [toId], references: [id], onDelete: SetNull)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  tasks     Task[]   @relation("MessageTasks")

  @@index([projectId, sentAt])
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  key          String        @unique // préfixe des tâches : BG-12
  color        String        @default("#3B6CF6")
  status       ProjectStatus @default(ACTIVE)
  endClient    String? // client final quand le projet passe par une agence
  siteUrl      String?
  description  String?
  statusNote   String? // « point d'étape » : où on en est, et la prochaine action
  statusNoteAt DateTime?
  dueDate      DateTime?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId   String?
  lead     User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  taskCounter Int        @default(0)
  tasks       Task[]
  deliveries  Delivery[]
  activities  Activity[]

  lastChasedAt   DateTime? // dernière relance du client sur ce projet
  clientMessages ClientMessage[]
  rounds         FeedbackRound[]

  // P4-09 : type, modèle de départ, pages et jalons
  type       ProjectType @default(OTHER)
  startDate  DateTime?
  zones      Zone[]
  milestones Milestone[]
  extras     Extra[]
}

enum ExtraStatus {
  DRAFT
  QUOTED
  APPROVED
  REJECTED
  INVOICED
  PAID
}

/// Avenant : modifications hors périmètre chiffrées, devisées puis facturées.
/// La facture elle-même est émise ailleurs : `invoiceRef` n'est qu'une référence (jamais de numérotation ici).
model Extra {
  id          String      @id @default(cuid())
  number      Int
  title       String
  amountCents Int?
  status      ExtraStatus @default(DRAFT)
  quotedAt    DateTime?
  approvedAt  DateTime?
  approvedBy  String?
  invoicedAt  DateTime?
  invoiceRef  String?
  paidAt      DateTime?
  createdAt   DateTime    @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, number])
  @@index([status])
}

enum ProjectType {
  VITRINE
  ECOMMERCE
  REFONTE
  MAINTENANCE
  SOCIAL
  OTHER
}

/// Page ou section d'un projet (« Homepage », « Fiche produit ») : référentiel des zones des tâches.
model Zone {
  id        String  @id @default(cuid())
  name      String
  url       String?
  position  Float   @default(0)
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, name])
}

/// Jalon de projet (« Maquettes validées », « Mise en ligne »).
model Milestone {
  id          String    @id @default(cuid())
  name        String
  dueDate     DateTime?
  completedAt DateTime?
  position    Float     @default(0)
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId, position])
}

/// Modèle de projet : jalons, pages et tâches de départ (échéances relatives au démarrage).
model ProjectTemplate {
  id         String         @id @default(cuid())
  name       String         @unique
  type       ProjectType    @default(OTHER)
  milestones String[]
  zones      String[]
  tasks      TemplateTask[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model TemplateTask {
  id          String          @id @default(cuid())
  title       String
  zone        String?
  milestone   String?
  estimateMin Int?
  offsetDays  Int? // échéance = démarrage + N jours
  position    Float           @default(0)
  templateId  String
  template    ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Task {
  id              String     @id @default(cuid())
  number          Int // numéro dans le projet (BG-12)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(NONE)
  zone            String? // page ou section concernée : « Homepage », « Fiche produit »
  source          String? // origine : « Retours Luna 06/10 »
  billable        Boolean    @default(false) // modification hors périmètre, à facturer
  dueDate         DateTime?
  position        Float      @default(0)
  completedAt     DateTime?
  statusChangedAt DateTime   @default(now()) // depuis quand la tâche est dans son statut (ex. « chez le client depuis 4 j »)
  waitingSince    DateTime? // posé à l'entrée dans « Chez le client », effacé à la sortie
  externalKey     String? // clé de déduplication d'un retour importé : sha1(page|retour) normalisés (src/lib/import-key.ts)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    User?   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  comments   Comment[]
  activities Activity[]

  // Relancer le client (P4-05)
  waitingFor   String? // « visuels HD », « textes page À propos »
  followUpAt   DateTime? // date de relance choisie à la main
  lastChasedAt DateTime?
  messages     ClientMessage[] @relation("MessageTasks")

  deliveries DeliveryTask[]

  // P4-09 : référentiels (Task.zone reste le libellé pendant la transition)
  zoneId      String?
  zoneRef     Zone?      @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  // P4-10 : hors périmètre chiffré, regroupé en avenants
  billingNote          String?
  estimatedAmountCents Int?
  extraId              String?
  extra                Extra?  @relation(fields: [extraId], references: [id], onDelete: SetNull)

  roundId String? // lot de retours d'origine (P4-06)
  round   FeedbackRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@unique([projectId, externalKey]) // plusieurs NULL autorisés
  @@index([projectId, status, position])
  @@index([assigneeId, status])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// Mise en ligne datée — la preuve de ce qui a été livré et quand.
model Delivery {
  id         String   @id @default(cuid())
  title      String
  notes      String?
  url        String?
  deployedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  closedRounds FeedbackRound[]

  // P4-07 : contenu et origine de la mise en ligne
  tasks       DeliveryTask[]
  source      Channel        @default(WEB)
  externalId  String?        @unique // identifiant chez l'hébergeur (déploiement Netlify, Vercel…)
  commitSha   String?
  context     String? // production, preview…
  confirmedAt DateTime?
  deletedAt   DateTime? // suppression annulable

  @@index([projectId, deployedAt])
}

/// Tâches livrées par une mise en ligne.
model DeliveryTask {
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@id([deliveryId, taskId])
  @@index([taskId])
}

/// Outbox d'événements : écrite dans la même transaction que le changement,
/// lue par le job `dispatch_events` (notifications, webhooks, temps réel, sync).
/// L'Activity reste le fil lisible de l'interface.
model Event {
  id           String    @id @default(cuid())
  type         String // task.created, task.status_changed, comment.created…
  payload      Json
  via          Channel   @default(WEB)
  projectId    String?
  taskId       String?
  actorId      String?
  createdAt    DateTime  @default(now())
  dispatchedAt DateTime?

  @@index([dispatchedAt, createdAt])
  @@index([projectId, createdAt])
}

/// File de travaux, consommée par /api/cron/tick (appelé chaque minute).
model Job {
  id        String    @id @default(cuid())
  kind      String // dispatch_events, daily, digest, intake…
  payload   Json      @default("{}")
  runAt     DateTime  @default(now())
  attempts  Int       @default(0)
  lockedAt  DateTime?
  doneAt    DateTime?
  lastError String?
  dedupeKey String?   @unique
  createdAt DateTime  @default(now())

  @@index([doneAt, runAt])
}

/// Dernier signal reçu par fournisseur (webhooks, cron) : panneau Intégrations.
model IntegrationStatus {
  provider       String    @id // cron, netlify, github, vercel, postmark, telegram…
  lastReceivedAt DateTime?
  lastOkAt       DateTime?
  lastError      String?
  lastErrorAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

/// Journal des connexions (réussies ou non) : Paramètres › Journal.
model LoginEvent {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  method    String   @default("PIN") // PIN, GOOGLE
  ip        String?
  ua        String?
  createdAt DateTime @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
}

/// Limitation de débit à fenêtre fixe (clé = politique + IP ou clé d'API).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  type       ActivityType @default(NOTE)
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  data       Json? // { from, to } : attribution, échéance, hors périmètre, priorité, titre

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  // SetNull : l'historique du projet garde la trace d'une tâche supprimée.
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([type, createdAt])
}
