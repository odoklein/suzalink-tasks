// Suzali Tasks — gestion de projets et de tâches de l'agence.
// Modélisé sur le fonctionnement réel des projets clients : retours qui
// arrivent par vagues, tâches bloquées côté client, mises en ligne datées.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum ClientKind {
  AGENCY // agence partenaire qui nous sous-traite (ex. 33 Degrés)
  DIRECT // client final en direct
}

enum ProjectStatus {
  ACTIVE
  WAITING_CLIENT
  PAUSED
  DONE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  WAITING_CLIENT
  REVIEW
  DONE
}

/// Type d'événement du journal d'activité : le texte français est généré à
/// l'écriture (src/lib/activity-copy.ts), le type et les valeurs restent
/// exploitables (rapports, délais « chez le client », litiges).
enum ActivityType {
  NOTE
  TASK_CREATED
  STATUS_CHANGED
  ASSIGNED
  BILLABLE_CHANGED
  DUE_CHANGED
  PRIORITY_CHANGED
  TITLE_CHANGED
  COMMENTED
  TASK_DELETED
  TASK_RESTORED
  IMPORTED
  DELIVERED
  CLIENT_MESSAGE
  PROJECT_UPDATED
}

enum Priority {
  NONE
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String // hash du code PIN à 6 chiffres
  color        String   @default("#3B6CF6")
  role         Role     @default(MEMBER)
  createdAt    DateTime @default(now())

  // Protection contre les essais en série : 5 erreurs → 15 min de blocage
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  assignedTasks Task[]     @relation("TaskAssignee")
  createdTasks  Task[]     @relation("TaskCreator")
  ledProjects   Project[]  @relation("ProjectLead")
  comments      Comment[]
  deliveries    Delivery[]
  activities    Activity[]
}

model Client {
  id        String     @id @default(cuid())
  name      String
  kind      ClientKind @default(DIRECT)
  contacts  String? // « Luna Cervi (cheffe de projet), Clémentine Burdet-Micolle »
  notes     String?
  createdAt DateTime   @default(now())

  projects Project[]
}

model Project {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  key          String        @unique // préfixe des tâches : BG-12
  color        String        @default("#3B6CF6")
  status       ProjectStatus @default(ACTIVE)
  endClient    String? // client final quand le projet passe par une agence
  siteUrl      String?
  description  String?
  statusNote   String? // « point d'étape » : où on en est, et la prochaine action
  statusNoteAt DateTime?
  dueDate      DateTime?
  archived     Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  leadId   String?
  lead     User?   @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)

  taskCounter Int        @default(0)
  tasks       Task[]
  deliveries  Delivery[]
  activities  Activity[]
}

model Task {
  id              String     @id @default(cuid())
  number          Int // numéro dans le projet (BG-12)
  title           String
  description     String?
  status          TaskStatus @default(TODO)
  priority        Priority   @default(NONE)
  zone            String? // page ou section concernée : « Homepage », « Fiche produit »
  source          String? // origine : « Retours Luna 06/10 »
  billable        Boolean    @default(false) // modification hors périmètre, à facturer
  dueDate         DateTime?
  position        Float      @default(0)
  completedAt     DateTime?
  statusChangedAt DateTime   @default(now()) // depuis quand la tâche est dans son statut (ex. « chez le client depuis 4 j »)
  waitingSince    DateTime? // posé à l'entrée dans « Chez le client », effacé à la sortie
  externalKey     String? // clé de déduplication d'un retour importé : sha1(page|retour) normalisés (src/lib/import-key.ts)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  projectId  String
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    User?   @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)

  comments   Comment[]
  activities Activity[]

  @@unique([projectId, number])
  @@unique([projectId, externalKey]) // plusieurs NULL autorisés
  @@index([projectId, status, position])
  @@index([assigneeId, status])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId   String
  task     Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

/// Mise en ligne datée — la preuve de ce qui a été livré et quand.
model Delivery {
  id         String   @id @default(cuid())
  title      String
  notes      String?
  url        String?
  deployedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Activity {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  type       ActivityType @default(NOTE)
  fromStatus TaskStatus?
  toStatus   TaskStatus?
  data       Json? // { from, to } : attribution, échéance, hors périmètre, priorité, titre

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@index([type, createdAt])
}
