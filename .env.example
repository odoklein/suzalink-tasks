# Base Postgres (Supabase) — Settings > Database > Connection string
# DATABASE_URL : connexion poolée (port 6543, ?pgbouncer=true)
# DIRECT_URL   : connexion directe (port 5432), utilisée par les migrations
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# Clé de signature des sessions : 32 caractères aléatoires minimum
# (ex. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`)
SESSION_SECRET=""

# Code PIN initial (6 chiffres) donné aux comptes créés par `npm run db:seed`
# (chacun le change ensuite dans Paramètres)
SEED_PASSWORD=""

# Adresse publique de l'outil (liens des e-mails, de l'agenda, des webhooks)
APP_URL="https://tasks.suzaliconseil.com"

# Secret du cron (/api/cron/tick, appelé chaque minute par Supabase pg_cron).
# Même valeur dans Supabase Vault (voir README « Tâches de fond »).
CRON_SECRET=""
# Ping de surveillance après chaque passage du cron (facultatif)
HEARTBEAT_URL=""

# Sentry (facultatif) : erreurs serveur
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""

# Réunions (README « Réunions », docs/REUNIONS-PLAN.md). Chaque groupe : tout ou rien.
# Google Agenda : client OAuth « Interne », redirection https://tasks.suzaliconseil.com/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Chiffrement des jetons Google : openssl rand -base64 32
TOKEN_ENC_KEY=""

# Robot d'enregistrement Vexa auto-hébergé (réseau privé, port 18056 par défaut)
VEXA_API_URL=""
VEXA_API_KEY=""
# Nom affiché dans la réunion (facultatif)
VEXA_BOT_NAME=""

# Mistral : compte rendu et actions proposées (et transcription si MEETING_TRANSCRIPTION=mistral)
MISTRAL_API_KEY=""
MISTRAL_MODEL=""
# vexa (transcription en direct par Vexa, GPU) ou mistral (Voxtral après la réunion)
MEETING_TRANSCRIPTION=""
